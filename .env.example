# Copy this file to .env and fill it in. The server won't start if a required value is missing.

# Required
CONN_STRING=mongodb+srv://user:password@cluster.example.mongodb.net/database
TOKEN_SECRET=at-least-32-random-characters-generate-your-own
SMTP_HOST=smtp.example.com
EMAIL=noreply@example.com
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Optional
# 465 (TLS, the default) or 587 (STARTTLS)
# SMTP_PORT=465
# EMAIL_ALIAS=Your App <noreply@example.com>
# Comma-separated origins allowed to call the API from a browser. Defaults to FRONTEND_URL.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated DNS servers for the database lookup. Without it the system's DNS is used.
# DNS_SERVERS=8.8.8.8,1.1.1.1
# PORT=4000
# NODE_ENV=production
# LOG_LEVEL=info
